# Copy to .env and adjust if needed
DB_NAME=minibank
DB_USERNAME=minibank
DB_PASSWORD=minibank
DB_PORT=5432
BACKEND_PORT=8080
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SPRING_PROFILES_ACTIVE=local
APP_PUBLIC_URL=http://localhost:3000
APP_MAIL_FROM=no-reply@minibank.local
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Mail: Mailhog is used when these are empty.
# Resend (production):
#   SPRING_PROFILES_ACTIVE=prod
#   APP_PUBLIC_URL=https://your-frontend-domain
