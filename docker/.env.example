#   SPRING_MAIL_USERNAME=resend
#   SPRING_MAIL_PASSWORD=re_your_api_key
#   SPRING_MAIL_SMTP_AUTH=true
#   SPRING_MAIL_STARTTLS=true
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=
SPRING_MAIL_STARTTLS=
