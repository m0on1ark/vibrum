# Supabase PostgreSQL (Session pooler, port 5432)
DB_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Gmail SMTP (use a 16-char Google App Password, not your regular password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_GMAIL@gmail.com
SPRING_MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
APP_MAIL_FROM=YOUR_GMAIL@gmail.com
